<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Разрешения кассы — все нормальные, кассир их не подтверждает:
        INTERNET — ОФД, сверка часов и доставка чека;
        ACCESS_NETWORK_STATE — досылка очереди ждёт сети, а не пробует вслепую.
        WorkManager добавляет свои: WAKE_LOCK — не уснуть посреди досылки,
        RECEIVE_BOOT_COMPLETED — вернуть расписание после перезагрузки.
        Службы переднего плана касса не заводит: её разрешение убрано.
        Уведомлений фоновая работа не показывает — их разрешения нет.
        REQUEST_INSTALL_PACKAGES — обновление с GitHub, мимо магазинов:
        касса скачивает APK выпуска и отдаёт его установщику системы.
        Само по себе ничего не ставит: разрешает владелец устройства один
        раз в настройках системы («Установка из этого источника»), а каждую
        установку подтверждает кассир в окне системы.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Подпись ЭЦП в eGov mobile: ссылка подписи открывается прямо в его
         пакете. С Android 11 чужой пакет без этого объявления не виден,
         и ссылка уходила браузеру. -->
    <queries>
        <package android:name="kz.mobile.mgov" />
    </queries>

    <application
        android:name=".SuperkassaApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Superkassa"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Superkassa.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Файлы кассы для других программ — по ссылке content://, а не
             путём: чужому процессу каталог кэша кассы не виден. Отдаются
             только скачанный APK новой версии (установщику системы)
             и форма чека, которой делятся с покупателем. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provided_files" />
        </provider>
    </application>

</manifest>
