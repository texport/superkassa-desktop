<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Тема окна под Compose: только фон окна до первого кадра и полосы
        системы. Цвета экранов задаёт `SuperkassaTheme`.
    -->
    <style name="Theme.Superkassa" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Заставка запуска: значок кассы на фирменном цвете. Android 12+
        рисует её сам, на ранних версиях — библиотека заставки. После
        первого кадра окно переходит на Theme.Superkassa.
    -->
    <style name="Theme.Superkassa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Superkassa</item>
    </style>
</resources>
